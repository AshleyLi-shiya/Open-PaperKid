{
  "manifest_version": 3,
  "name": "Open-PaperKid — 小学生都懂的论文助手",
  "version": "0.2.0",
  "description": "Bilingual simple-language paper assistant. Summarize, translate, and Q&A on academic papers. BYOK — your API key never leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open-PaperKid"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://*.arxiv.org/*",
    "https://openreview.net/*",
    "https://huggingface.co/papers/*",
    "https://paperswithcode.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/pdf/*",
        "https://openreview.net/forum?id=*",
        "https://huggingface.co/papers/*"
      ],
      "js": ["content/contentScript.js"],
      "css": ["content/contentStyle.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "sidepanel/*", "options/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}