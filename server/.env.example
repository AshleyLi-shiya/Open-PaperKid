# Open-PaperKid server config — copy to .env and edit
#
# Server is "BYOK" by design: API keys are supplied by the *client*
# (Chrome extension or CLI flags) per request. These env vars only set
# fallbacks for CLI usage or for self-hosted deployments.

PORT=5174
STORAGE_DIR=./.open-paperkid-data
MAX_PDF_PAGES=40
MAX_CHUNK_TOKENS=800

# ----- CLI fallback (used when no per-request headers are sent) -----
# Most users do NOT need to set these.
LLM_BACKEND=openai

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 通义千问 Qwen (Alibaba DashScope, OpenAI-compatible)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus-latest
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Kimi (Moonshot, OpenAI-compatible)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 智谱 GLM (Zhipu, OpenAI-compatible)
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Ollama (local, free)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
