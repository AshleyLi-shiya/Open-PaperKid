{
  "name": "open-paperkid-server",
  "version": "0.2.0",
  "description": "Open-PaperKid backend — bilingual simple-language paper assistant (BYOK, MIT)",
  "type": "module",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs ../tests/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
